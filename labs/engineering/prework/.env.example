# Copy this file to .env, fill in ONE provider block, and never commit .env.
# The .gitignore in this folder already excludes it.
# Model names are as of 2026; check your provider for current ones.

# --- Azure OpenAI -----------------------------------------------------------
# MODEL=azure/<your-deployment-name>
# AZURE_API_KEY=
# AZURE_API_BASE=https://<your-resource>.openai.azure.com
# AZURE_API_VERSION=<the API version your organization uses>

# --- OpenAI -----------------------------------------------------------------
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=

# --- Anthropic --------------------------------------------------------------
# MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=
